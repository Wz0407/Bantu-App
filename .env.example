# MyBantu local development configuration.
# Copy to `.env` and adjust as needed. Never commit `.env`.
# All services bind to loopback by default; no cloud endpoints exist.

# --- ASP.NET Core API (public application boundary) ---
MYBANTU_API_URL=http://127.0.0.1:5100

# --- Document AI internal service (loopback only; never expose to the browser) ---
MYBANTU_DOCUMENT_AI_URL=http://127.0.0.1:5210

# --- React dev server ---
MYBANTU_WEB_URL=http://127.0.0.1:5173

# --- Local storage roots (relative to repository root) ---
MYBANTU_DATA_DIR=./data
MYBANTU_MODELS_DIR=./models

# --- Native translation library ---
# Directory that will contain translation model files in Phase 1.
# Leaving this unset means the translation engine reports NotConfigured.
MYBANTU_TRANSLATION_MODEL_DIR=
